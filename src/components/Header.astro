---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
const ICON_SIZE = 24;
---

<header dir="ltr">
	<nav>
		<div class="nav-left">
			<h2>
				<a href="/" aria-label={SITE_TITLE} style="font-size:0;">
					<svg
						xmlns="http://www.w3.org/2000/svg"
						viewBox="9 6 182 177"
						preserveAspectRatio="xMidYMid slice"
						role="img"
						aria-labelledby="logo-title logo-description"
						class="site-logo"
					>
						<desc id="logo-description">A thick rainbow pentagon with five inward-arching edges.</desc>

						<defs>
							<linearGradient id="rainbow-gradient" x1="0%" y1="0%" x2="100%" y2="100%">
								<stop offset="0%" stop-color="#ff3b5c" />
								<stop offset="18%" stop-color="#ff8a00" />
								<stop offset="36%" stop-color="#ffd600" />
								<stop offset="52%" stop-color="#22c55e" />
								<stop offset="68%" stop-color="#00b8d9" />
								<stop offset="84%" stop-color="#4f46e5" />
								<stop offset="100%" stop-color="#b832e6" />
							</linearGradient>
						</defs>

						<path
							d="M 100 18 Q 126 61, 178 72 Q 139 98, 150 170 Q 100 139, 50 170 Q 61 98, 22 72 Q 74 61, 100 18 Z"
							fill="none"
							stroke="url(#rainbow-gradient)"
							stroke-width="25"
							stroke-linecap="round"
							stroke-linejoin="round"
						/>
					</svg>
					<span class="sr-only">{SITE_TITLE}</span>
				</a>
			</h2>

			<div class="internal-links">
				<HeaderLink href="/">Home</HeaderLink>
				<HeaderLink href="/blog">Blog</HeaderLink>
				<HeaderLink href="/projects">Projects</HeaderLink>
				<HeaderLink href="/resume">Résumé</HeaderLink>
			</div>
		</div>

		<div class="nav-right">
			<div class="social-links">
				<a href="https://linkedin.com/in/david-belayev-gal" target="_blank">
				<span class="sr-only">Connect with me on LinkedIn</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width={ICON_SIZE} height={ICON_SIZE} astro-icon="social/linkedin"
					><path
						fill="currentColor"
						d="M0 1.146C0 .513.526 0 1.175 0h13.65C15.474 0 16 .513 16 1.146v13.708c0 .633-.526 1.146-1.175 1.146H1.175C.526 16 0 15.487 0 14.854zm4.943 12.248V6.169H2.542v7.225zm-1.2-8.212c.837 0 1.358-.554 1.358-1.248-.015-.709-.52-1.248-1.342-1.248S2.4 3.226 2.4 3.934c0 .694.521 1.248 1.327 1.248zm4.908 8.212V9.359c0-.216.016-.432.08-.586.173-.431.568-.878 1.232-.878.869 0 1.216.662 1.216 1.634v3.865h2.401V9.25c0-2.22-1.184-3.252-2.764-3.252-1.274 0-1.845.7-2.165 1.193v.025h-.016l.016-.025V6.169h-2.4c.03.678 0 7.225 0 7.225z"/></svg
				>
			</a>
			<a href="https://github.com/davidbelayev" target="_blank">
				<span class="sr-only">Go to my GitHub repo</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width={ICON_SIZE} height={ICON_SIZE} astro-icon="social/github"
					><path
						fill="currentColor"
						d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
					></path></svg
				>
			</a>
		</div>

			<!-- Theme toggle button -->
			<button class="theme-toggle" aria-label="Toggle dark mode" title="Toggle dark mode">
			<span class="sr-only">Toggle dark mode</span>
			<!-- moon / sun icons toggle via CSS visibility -->
			<!-- DARK MODE (crescent) -->
			<svg class="icon-moon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" width="32" height="32" fill="none" aria-label="Dark mode">
			  <path
			    d="
			      M 20.8 5.8

			      C 16.1 5.2, 10.7 7.0, 8.2 11.9
			      C 6.5 15.4, 7.1 20.8, 10.0 24.2
			      C 12.5 27.2, 17.9 28.2, 22.4 25.6
			      C 24.3 24.5, 25.0 22.9, 24.1 22.2

			      C 22.8 21.2, 20.8 22.7, 18.0 21.0
			      C 15.2 19.3, 14.4 17.0, 15.0 14.5
			      C 15.5 12.4, 16.7 11.2, 19.0 9.3
			      C 20.7 7.9, 22.1 6.0, 20.8 5.8

			      Z
			    "
			    stroke="currentColor"
			    stroke-width="2.15"
			    stroke-linecap="round"
			    stroke-linejoin="round"
			  />
			</svg>

			<!-- LIGHT MODE (deliberately awful sun) -->
			<svg class="icon-sun" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" width="32" height="32" fill="none" aria-label="Light mode">
			  <g
			    stroke="currentColor"
			    stroke-width="2.15"
			    stroke-linecap="round"
			    stroke-linejoin="round"
			  >
			    <!-- malformed sun -->
			    <path
			      d="
			        M 10.2 11.7
			        C 12.0 8.1, 14.4 9.6, 16.1 8.7
			        C 18.9 7.4, 18.2 10.6, 21.5 11.1
			        C 24.1 11.6, 21.8 14.1, 23.0 16.4
			        C 24.0 18.5, 21.0 18.7, 20.8 21.1
			        C 20.5 23.2, 17.8 21.7, 15.6 23.0
			        C 12.7 24.7, 13.0 21.2, 10.8 20.8
			        C 7.5 20.2, 9.9 17.7, 8.7 15.9
			        C 7.3 13.8, 10.0 13.6, 10.2 11.7
			        Z
			      "
			    />

			    <!-- badly placed, mismatched rays -->
			    <path d="M14.1 6.5 L13.4 2.9" />
			    <path d="M19.7 7.8 L21.7 4.1" />
			    <path d="M23.2 11.4 L28.1 9.8" />
			    <path d="M24.1 17.1 L29.3 18.4" />
			    <path d="M20.4 22.7 L22.6 27.6" />
			    <path d="M14.4 24.3 L13.2 29.0" />
			    <path d="M9.4 21.3 L5.8 24.9" />
			    <path d="M7.4 16.0 L2.8 15.2" />
			    <path d="M9.4 10.1 L6.4 6.5" />
			  </g>
			</svg>
			</button>
		</div>
	</nav>

	<!-- Off-canvas sidebar for portrait / narrow tall screens -->
	<div class="overlay" data-header-overlay></div>
	<aside class="mobile-sidebar" data-mobile-sidebar aria-hidden="true">
		<div class="sidebar-inner">
			<nav class="sidebar-links">
				<HeaderLink href="/">Home</HeaderLink>
				<HeaderLink href="/blog">Blog</HeaderLink>
				<HeaderLink href="/projects">Projects</HeaderLink>
				<HeaderLink href="/resume">Résumé</HeaderLink>
			</nav>
			<div class="sidebar-social">
				<a href="https://linkedin.com/in/david-belayev-gal" target="_blank" rel="noopener noreferrer">
					<span class="sr-only">Connect with me on LinkedIn</span>
					<svg viewBox="0 0 16 16" aria-hidden="true" width={ICON_SIZE} height={ICON_SIZE} astro-icon="social/linkedin">
						<path fill="currentColor" d="M0 1.146C0 .513.526 0 1.175 0h13.65C15.474 0 16 .513 16 1.146v13.708c0 .633-.526 1.146-1.175 1.146H1.175C.526 16 0 15.487 0 14.854zm4.943 12.248V6.169H2.542v7.225zm-1.2-8.212c.837 0 1.358-.554 1.358-1.248-.015-.709-.52-1.248-1.342-1.248S2.4 3.226 2.4 3.934c0 .694.521 1.248 1.327 1.248zm4.908 8.212V9.359c0-.216.016-.432.08-.586.173-.431.568-.878 1.232-.878.869 0 1.216.662 1.216 1.634v3.865h2.401V9.25c0-2.22-1.184-3.252-2.764-3.252-1.274 0-1.845.7-2.165 1.193v.025h-.016l.016-.025V6.169h-2.4c.03.678 0 7.225 0 7.225z"/>
					</svg>
				</a>
				<a href="https://github.com/davidbelayev" target="_blank" rel="noopener noreferrer">
					<span class="sr-only">Go to my GitHub repo</span>
					<svg viewBox="0 0 16 16" aria-hidden="true" width={ICON_SIZE} height={ICON_SIZE} astro-icon="social/github">
						<path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"/>
					</svg>
				</a>
			</div>
		</div>
	</aside>

	<script>
		// Theme toggle: toggles `dark` class on <html> and persists choice in localStorage.
		(function () {
			const KEY = 'theme';
			const root = document.documentElement;
			const btn = document.querySelector('.theme-toggle');

			function applyTheme(theme) {
				if (theme === 'dark') {
					root.classList.add('dark');
					if (btn) btn.setAttribute('aria-pressed', 'true');
				} else {
					root.classList.remove('dark');
					if (btn) btn.setAttribute('aria-pressed', 'false');
				}
			}

			// init
			try {
				const stored = localStorage.getItem(KEY);
				if (stored) applyTheme(stored);
				else {
					const prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
					applyTheme(prefersDark ? 'dark' : 'light');
				}
			} catch (e) {
				// localStorage might be unavailable; silently ignore
			}

			if (!btn) return;
			btn.addEventListener('click', function () {
				const isDark = root.classList.contains('dark');
				const next = isDark ? 'light' : 'dark';
				applyTheme(next);
				try { localStorage.setItem(KEY, next); } catch (e) {}
			});
		})();
	</script>

	<script>
		// Sidebar toggle: clicking the logo toggles sidebar in portrait orientation.
		(function () {
			const body = document.body;
			const logoLink = document.querySelector('header nav .nav-left h2 a');
			const overlay = document.querySelector('[data-header-overlay]');
			const sidebar = document.querySelector('[data-mobile-sidebar]');

			function isPortrait() {
				return window.matchMedia && window.matchMedia('(orientation: portrait)').matches;
			}

			function openSidebar() {
				body.classList.add('sidebar-open');
				sidebar && sidebar.setAttribute('aria-hidden', 'false');
				logoLink && logoLink.setAttribute('aria-expanded', 'true');
			}

			function closeSidebar() {
				body.classList.remove('sidebar-open');
				sidebar && sidebar.setAttribute('aria-hidden', 'true');
				logoLink && logoLink.setAttribute('aria-expanded', 'false');
			}

			if (!logoLink) return;

			logoLink.addEventListener('click', function (e) {
				if (!isPortrait()) return; // preserve normal link behavior on wider screens
				e.preventDefault();
				const open = body.classList.contains('sidebar-open');
				if (open) closeSidebar(); else openSidebar();
			});

			overlay && overlay.addEventListener('click', closeSidebar);
			// Close on Escape
			document.addEventListener('keydown', (ev) => { if (ev.key === 'Escape') closeSidebar(); });
		})();
	</script>
</header>
<style>

	/* Make header sticky and sit above content */
	header {
		margin: 0;
		padding: 0.75rem 1.5rem;
		background: var(--header-bg, white);
		box-shadow: 0 1px 6px rgba(var(--black), 4%);
		position: sticky;
		top: 0;
		z-index: 1100;
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
	}

	.nav-left { display:flex; align-items:center; gap:0.5rem; }
	.internal-links { display:flex; gap:0.4rem; margin-left:0.75rem; }
	.nav-right { display:flex; align-items:center; gap:0.4rem;  } /* debug */
	.nav-right > * > * { border: 1px solid transparent; } /* debug */
	nav a {
		/* compact link padding to reduce header height */
		padding: 0.25em 0.35em;
		color: var(--black);
		border-bottom: 3px solid transparent;
		text-decoration: none;
		line-height: 1;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	.social-links,
	.social-links a {
		display: flex;
	}
	@media (max-width: 720px) {
		.social-links {
			display: none;
		}
	}

	/* Theme toggle button styles */
	.theme-toggle {
		background: transparent;
		border: none;
		padding: 0.15em; /* smaller hit area but slimmer header */
		margin-left: 0.25em;
		cursor: pointer;
		color: rgb(var(--gray-dark));
		display: inline-flex;
		align-items: center;
		justify-content: center;
		border-radius: 6px;
	}

	.theme-toggle:hover {
		background: rgba(var(--gray), 6%);
	}

	.icon-sun { display: inline-block; }
	.icon-moon { display: none; }
	html.dark .icon-sun { display: none; }
	html.dark .icon-moon { display: inline-block; }

	/* Logo sizing: restored to original size so SVG remains unaffected */
	.site-logo { width: 32px; height: 32px; display: block; }
	@media (max-width: 720px) {
		.site-logo { width: 28px; height: 28px; }
	}

	/* Mobile sidebar (portrait / tall screens) */
	.overlay { display:none; position:fixed; inset:0; background: rgba(0,0,0,0.45); z-index:999; }
	.mobile-sidebar { position:fixed; left:-260px; top:0; bottom:0; width:240px; background: var(--surface-bg); box-shadow: 2px 0 14px rgba(0,0,0,0.18); z-index:1000; transition:left 260ms ease; overflow:auto; }
	.mobile-sidebar[aria-hidden="false"] { left:0; }
	.sidebar-inner { padding: 1.25rem; }
	.sidebar-links { display:flex; flex-direction:column; gap:0.5rem; }
	.sidebar-links a { padding: 0.5rem 0.25rem; border-radius:6px; display:block; }

	/* Social icons in the sidebar: center them, add spacing, and use dark color */
	.sidebar-social { display:flex; justify-content:center; gap:1rem; align-items:center; margin-top: 1rem; }
	.sidebar-social a { color: rgb(var(--black)); display:inline-flex; align-items:center; justify-content:center; }
	.sidebar-social svg { width: 28px; height: 28px; }

	/* Only enable sidebar behavior in portrait orientation (height > width) */
	@media (orientation: portrait) {
		.internal-links { display:none; }
		.social-links { display:none; }
		.overlay { display:none; }
	}

	/* When sidebar is open, show overlay */
	body.sidebar-open .overlay { display:block; }
	body.sidebar-open .mobile-sidebar { left:0; }
</style>
