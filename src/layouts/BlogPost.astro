---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage, lang, direction } = Astro.props;
const postLang = lang ?? 'en';
const postDir = direction ?? (postLang === 'he' ? 'rtl' : 'ltr');

// Ensure meta title places the '+' correctly for Security+ in RTL locales by adding an LRM.
const metaTitle = title && title.includes('Security+') ? title.replaceAll('Security+', 'Security+\u200E') : title;

// Prepare parts for rendering a visible H1 where 'Security+' is wrapped in an LTR span.
const titleParts = title && title.includes('Security+') ? title.split('Security+') : null;

// Load the security-plus prompt file as raw text so the bundler includes it in the build.
import securityPromptRaw from '../assets/securityplus-prompt.md?raw';
const securityPrompt = typeof securityPromptRaw === 'string' ? securityPromptRaw : '';
---

<html lang={postLang} dir={postDir}>
	<head>
		<BaseHead title={metaTitle} description={description} />
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.prose {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: rgb(var(--gray-dark));
			}

			/* RTL handling for Hebrew posts */
			.prose[dir="rtl"] {
				direction: rtl;
				unicode-bidi: isolate-override;
				text-align: right;
			}

			/* Ensure inline elements inherit direction and avoid bidi leaks */
			.prose[dir="rtl"] > * {
				direction: inherit;
				unicode-bidi: isolate-override;
			}

			/* Let the browser decide direction for inline LTR runs, isolate to avoid bidi leaks */
			.prose[dir="rtl"] a,
			.prose[dir="rtl"] code,
			.prose[dir="rtl"] pre,
			.prose[dir="rtl"] strong,
			.prose[dir="rtl"] em,
			.prose[dir="rtl"] span {
				direction: auto;
				unicode-bidi: isolate;
			}
			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
			}
			.date {
				margin-bottom: 0.5em;
				color: rgb(var(--gray));
			}
			.last-updated-on {
				font-style: italic;
			}

			/* Prompt box styles (fixed-size, scrollable) */
			.prompt-box {
				border: 1px solid rgba(var(--gray), 0.08);
				background: var(--surface-bg);
				color: rgb(var(--text));
				padding: 12px;
				border-radius: 8px;
				max-height: 320px;
				overflow: auto;
				font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, 'Roboto Mono', 'Helvetica Neue', monospace;
				font-size: 0.95rem;
				box-shadow: var(--box-shadow);
				margin: 1em 0;
			}

			/* Keep the copy button visible at the top when scrolling */
			.prompt-box { position: relative; }
			.copy-row {
				position: sticky;
				top: 0;
				display: flex;
				justify-content: flex-end;
				padding-bottom: 8px;
				background: var(--surface-bg);
				z-index: 2;
			}

			/* Ensure prompt box stays LTR even when inside an RTL .prose container */
			.prose[dir="rtl"] .prompt-box {
				direction: ltr !important;
				unicode-bidi: isolate;
				text-align: left;
			}
			.prompt-box .prompt-content {
				margin: 0;
				white-space: pre-wrap;
				color: inherit;
			}
			.copy-prompt-button {
				background: var(--accent);
				color: white;
				border: none;
				padding: 6px 10px;
				border-radius: 6px;
				cursor: pointer;
			}
		</style>
		<script>
			// Copy button handler for prompt box
			document.addEventListener('click', (e) => {
				const el = e.target;
				if (el && el.classList && el.classList.contains('copy-prompt-button')) {
					const targetId = el.getAttribute('data-target') || 'post-prompt';
					const contentEl = document.getElementById(targetId);
					if (!contentEl) return;
					navigator.clipboard.writeText(contentEl.innerText).then(() => {
						const prev = el.textContent;
						el.textContent = 'הועתק';
						setTimeout(() => { el.textContent = prev; }, 2000);
					}).catch(() => { /* ignore */ });
				}
			});
		</script>
	</head>

	<body dir={postDir} class={postDir === 'rtl' ? 'rtl-post' : ''}>
		<Header />
		<main>
			<article>
				<div class="hero-image">
					{heroImage && <Image width={1020} height={510} src={heroImage} alt="" />}
				</div>
				<div class="prose" dir={postDir}>
					<div class="title">
						<div class="date">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<div class="last-updated-on">
										Last updated on <FormattedDate date={updatedDate} />
									</div>
								)
							}
						</div>
						{titleParts ? (
							<h1>{titleParts[0]}<span dir="ltr">Security+</span>{titleParts.slice(1).join('Security+')}</h1>
						) : (
							<h1>{title}</h1>
						)}
						<hr />
					</div>
					<slot />

					{title && title.includes('Security+') && securityPrompt ? (
						<div class="prompt-box" dir="ltr" aria-label="Security+ prompt">
							<div class="copy-row">
								<button class="copy-prompt-button" data-target="post-prompt">העתק</button>
							</div>
							<pre id="post-prompt" class="prompt-content" dir="ltr">{securityPrompt}</pre>
						</div>
					) : null}
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
