---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage, heroImageLight, heroImageDark, lang, direction, showPrompt } = Astro.props;
const postLang = lang ?? 'en';
const postDir = direction ?? (postLang === 'he' ? 'rtl' : 'ltr');

// Ensure meta title places the '+' correctly for Security+ in RTL locales by adding an LRM.
const metaTitle = title && title.includes('Security+') ? title.replaceAll('Security+', 'Security+\u200E') : title;

// Prepare parts for rendering a visible H1 where 'Security+' is wrapped in an LTR span.
const titleParts = title && title.includes('Security+') ? title.split('Security+') : null;

// Load the security-plus prompt file as raw text so the bundler includes it in the build.
import securityPromptRaw from '../assets/securityplus-prompt.md?raw';
const securityPrompt = typeof securityPromptRaw === 'string' ? securityPromptRaw : '';
---

<html lang={postLang} dir={postDir}>
	<head>
		<BaseHead title={metaTitle} description={description} />
		<style>
			main {
				width: 100%;
				max-width: 980px;
				box-sizing: border-box;
				margin: 0 auto;
				padding: var(--page-padding-vertical) var(--page-padding-horizontal);
			}

			@media (max-width: 720px) {
				/* Reduce horizontal padding only for blog post pages on small screens */
				main {
					padding-left: 0.75rem !important;
					padding-right: 0.75rem !important;
				}
				.prose {
					padding-left: 0.5rem !important;
					padding-right: 0.5rem !important;
				}
			}
			.hero-image {
				width: 100%;
				display: flex;
				justify-content: center; /* center the constrained hero */
			}
			/* Constrained hero container keeps a 4:3 aspect ratio similar to homepage cards */
			.hero-image .thumb {
				width: 100%;
				max-width: 480px; /* match /projects card width visually */
				aspect-ratio: 4 / 3;
				overflow: hidden;
				background: var(--surface-bg);
				border-radius: 10px; /* card-like rounded frame */
				box-shadow: var(--box-shadow);
			}
			.hero-image img {
				width: 100%;
				height: 100%;
				display: block;
				object-fit: cover; /* fill the 4:3 frame without distortion */
				border-radius: 6px; /* match inner image rounding on project cards */
			}
			.prose {
				width: 100%;
				max-width: 980px;
				margin: auto;
				padding: 1em;
				color: rgb(var(--gray-dark));
			}

			/* RTL handling for Hebrew posts */
			.prose[dir="rtl"] {
				direction: rtl;
				unicode-bidi: isolate-override;
				text-align: right;
			}

			/* Ensure inline elements inherit direction and avoid bidi leaks */
			.prose[dir="rtl"] > * {
				direction: inherit;
				unicode-bidi: isolate-override;
			}

			/* Let the browser decide direction for inline LTR runs, isolate to avoid bidi leaks */
			.prose[dir="rtl"] a,
			.prose[dir="rtl"] code,
			.prose[dir="rtl"] pre,
			.prose[dir="rtl"] strong,
			.prose[dir="rtl"] em,
			.prose[dir="rtl"] span {
				direction: auto;
				unicode-bidi: isolate;
			}
			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
				font-size: var(--h2-size); /* slightly smaller title for blog hero alignment */
			}
			.date {
				margin-bottom: 0.5em;
				color: rgb(var(--gray));
			}
			.last-updated-on {
				font-style: italic;
			}

			/* Prompt box styles (fixed-size, scrollable) */
			.prompt-box {
				border: 1px solid rgba(var(--gray), 0.08);
				background: var(--surface-bg);
				color: rgb(var(--text));
				padding: 0 12px 12px 12px;
				border-radius: 8px;
				max-height: 320px;
				overflow: auto;
				font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, 'Roboto Mono', 'Helvetica Neue', monospace;
				font-size: 0.95rem;
				box-shadow: var(--box-shadow);
				margin: 1em 0;
			}

			/* Keep the copy button visible at the top when scrolling */
			.prompt-box { position: relative; }
			.copy-row {
						position: sticky;
						top: 0;
						display: flex;
						justify-content: flex-end;
						padding: 8px 0; /* add top and bottom spacing so button isn't smothered */
						background: var(--surface-bg);
						z-index: 2;
			}

			/* Ensure prompt box stays LTR even when inside an RTL .prose container */
			.prose[dir="rtl"] .prompt-box {
				direction: ltr !important;
				unicode-bidi: isolate;
				text-align: left;
			}
			.prompt-box .prompt-content {
				margin: 0;
				padding-top: 12px;
				white-space: pre-wrap;
				color: inherit;
			}
					.copy-prompt-button {
						background: transparent; /* no background so icon feels light */
						color: rgb(var(--text));
						border: none;
						padding: 6px;
						display: inline-flex;
						align-items: center;
						justify-content: center;
						gap: 6px;
						border-radius: 6px;
						cursor: pointer;
						min-width: 50px;
						height: 50px;
					}

					.copy-prompt-button svg {
						width: 34px; /* twice the previous visible size */
						height: 34px;
					}

					@media (prefers-color-scheme: dark) {
						.copy-prompt-button {
							color: white; /* invert: light icon on dark backgrounds */
						}
					}
			}
		</style>
		<script>
					// Copy button handler for prompt box
					document.addEventListener('click', (e) => {
						const el = e.target.closest && e.target.closest('.copy-prompt-button') || e.target;
						if (el && el.classList && el.classList.contains('copy-prompt-button')) {
							const targetId = el.getAttribute('data-target') || 'post-prompt';
							const contentEl = document.getElementById(targetId);
							if (!contentEl) return;
							navigator.clipboard.writeText(contentEl.innerText).then(() => {
								const prevHtml = el.innerHTML;
								el.textContent = 'הועתק';
								setTimeout(() => { el.innerHTML = prevHtml; }, 2000);
							}).catch(() => { /* ignore */ });
						}
						});
		</script>
	</head>

	<body dir={postDir} class={postDir === 'rtl' ? 'rtl-post' : ''}>
		<Header />
		<main>
			<article>
				<div class="hero-image">
					{
						(() => {
							if (heroImageLight && heroImageDark) {
								const light = typeof heroImageLight === 'string' ? heroImageLight : (heroImageLight && heroImageLight.src ? heroImageLight.src : null);
								const dark = typeof heroImageDark === 'string' ? heroImageDark : (heroImageDark && heroImageDark.src ? heroImageDark.src : null);
								const fallback = typeof heroImage === 'string' ? heroImage : (heroImage && heroImage.src ? heroImage.src : '');
								return (<div class="thumb"><img class="theme-img" src={light || fallback} data-img-light={light} data-img-dark={dark} data-img-default={fallback} alt="" /></div>);
							}

							if (!heroImage) return null;
							// Determine a public-facing basename to construct light/dark candidates.
							const src = typeof heroImage === 'string' ? heroImage : (heroImage && heroImage.src ? heroImage.src : null);
							const name = src ? src.split('/').pop().split('?')[0] : null;
							const ext = name && name.includes('.') ? name.slice(name.lastIndexOf('.')) : '';
							const base = name ? name.replace(ext, '') : '';
							// Candidate paths
							const lightCandidate = `/assets/${base}_light${ext}`;
							const darkCandidate = `/assets/${base}_dark${ext}`;
							const fallback = `/assets/${name}`;
							// Special-case mapping for securityplus_main -> secplus_light
							const specialLight = name === 'securityplus_main.png' ? '/assets/secplus_light.png' : lightCandidate;
							const specialDark = name === 'securityplus_main.png' ? '/assets/secplus_dark.png' : darkCandidate;

							return (
								<div class="thumb"><img class="theme-img" src={specialLight} data-img-light={specialLight} data-img-dark={specialDark} data-img-default={fallback} alt="" /></div>
							);
						})()
					}
				</div>
				<div class="prose" dir={postDir}>
					<div class="title">
						<div class="date">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<div class="last-updated-on">
										Last updated on <FormattedDate date={updatedDate} />
									</div>
								)
							}
						</div>
						{titleParts ? (
							<h1>{titleParts[0]}<span dir="ltr">Security+</span>{titleParts.slice(1).join('Security+')}</h1>
						) : (
							<h1>{title}</h1>
						)}
						<hr />
					</div>
					<slot />

					{title && title.includes('Security+') && securityPrompt && showPrompt !== false ? (
						<div class="prompt-box" dir="ltr" aria-label="Security+ prompt">
									<div class="copy-row">
										<button class="copy-prompt-button" data-target="post-prompt" aria-label="Copy">
											<svg
												xmlns="http://www.w3.org/2000/svg"
												viewBox="0 0 32 32"
												width="32"
												height="32"
												fill="none"
												aria-hidden="true"
											>
												<g
													stroke="currentColor"
													stroke-width="2.15"
													stroke-linecap="round"
													stroke-linejoin="round"
												>
													<path d="M 9.4 6.8 C 9.7 5.8, 10.6 5.5, 11.8 5.7 L 22.6 6.2 C 24.1 6.3, 24.6 7.2, 24.4 8.5 L 23.8 23.9 C 23.7 25.4, 22.8 26.2, 21.5 26.0 L 10.7 25.4 C 9.3 25.3, 8.6 24.2, 8.8 22.9 Z" />
													<path d="M12.3 11.2 L19.8 11.5" />
													<path d="M12.0 15.1 L20.9 14.8" />
													<path d="M12.5 19.0 L17.8 19.3" />
													<path d="M 24.7 11.0 L 28.0 10.7 L 27.7 14.2" />
													<path d="M 27.8 10.8 L 24.6 14.1" />
												</g>
											</svg>
										</button>
									</div>
							<pre id="post-prompt" class="prompt-content" dir="ltr">{securityPrompt}</pre>
						</div>
					) : null}
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
