---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			/* Small showcase grid for highlighted projects and a blog post */
			.showcase {
				margin-top: 3rem;
			}
			.showcase-grid {
				display: flex;
				gap: 2rem;
				align-items: center;
				overflow-x: auto;
				padding: 2rem; /* vertical + horizontal padding so edge items don't touch border */
				-webkit-overflow-scrolling: touch;
				justify-content: flex-start; /* align items to start so scroll begins at first item */
				/* make scroll treat the container padding as scrollable offsets */
				scroll-padding-inline: 2rem;
			}
			.showcase .card {
				background: var(--surface-bg);
				padding: 0; /* removed padding for showcase objects */
				border-radius: 10px;
				text-align: center;
				text-decoration: none;
				color: inherit;
				display: flex;
				flex-direction: column;
				align-items: stretch;
				justify-content: center; /* vertically center card content */
				min-width: 260px;
				flex: 0 0 260px; /* fixed card width to create predictable horizontal scroll */
				
			}
			.showcase .card .thumb {
				width: 100%;
				aspect-ratio: 4 / 3;
				overflow: hidden;
				display: block;
				border-radius: 8px;
				background: var(--surface-bg);	
				box-shadow: var(--box-shadow);
			}

			.showcase .card .thumb img {
				width: 100%;
				height: 100%;
				object-fit: cover; /* preserve aspect, fill frame */
				display: block;
			}

			/* make cards slightly smaller on narrow screens */
			@media (max-width: 720px) {
				.showcase .card { min-width: 200px; flex: 0 0 200px; }
			}
			/* lightweight custom scrollbar for WebKit */
			.showcase-grid::-webkit-scrollbar { height: 8px; }
			.showcase-grid::-webkit-scrollbar-thumb { background: rgba(var(--gray), 0.12); border-radius: 8px; }
			.showcase .card h4 { margin: 0.5rem 0 0 0; }
			@media (max-width: 720px) {
				.showcase { margin-top: 2rem; }
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="about" aria-labelledby="about-heading" style="text-align: center; margin-bottom: 4rem;">
				<h2 id="about-heading">About</h2>
				<p>
					My name is David Belayev Gal.<br />Computer Science major going into cybersecurity.<br />Feel free to explore and let me know what you think.
				</p>
			</section>

			<section class="showcase" aria-labelledby="showcase-heading">
				<h2 id="showcase-heading">Showcase</h2>
				<div class="showcase-grid">
					<a class="card" href="/projects/incident-reports/cyberlabs-final" aria-label="CyberLabs Final">
						<div class="thumb">
								    <img class="theme-img theme-thumb" src="/assets/images/ransomware_light.png" data-img-light="/assets/images/ransomware_light.png" data-img-dark="/assets/images/ransomware_dark.png" data-img-default="/assets/images/ransomware_light.png" alt="Ransomware Report" />
						</div>
					</a>
					<a class="card" href="/projects/incident-reports/cyberlabs-test" aria-label="CyberLabs Test">
						<div class="thumb">
							<img class="theme-img theme-thumb" src="/assets/images/bruteforce-to-exfiltration_light.png" data-img-light="/assets/images/bruteforce-to-exfiltration_light.png" data-img-dark="/assets/images/bruteforce-to-exfiltration_dark.png" data-img-default="/assets/images/bruteforce-to-exfiltration_light.png" alt="Brute-force to Exfiltration" />
						</div>
					</a>
					<a class="card" href="/blog/security-plus-guide/" aria-label="Security+ Guide">
						<div class="thumb">
							<img class="theme-img theme-thumb" src={'/assets' + '/secplus_light.png'} data-img-light={'/assets' + '/secplus_light.png'} data-img-dark={'/assets' + '/secplus_dark.png'} data-img-default={'/assets' + '/secplus_light.png'} alt="Security+ Guide" />
						</div>
					</a>
				</div>
			</section>
		</main>
		<Footer />
	</body>

				
</html>
