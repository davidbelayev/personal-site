---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const pageTitle = 'Projects';
const pageDescription = 'Project portfolio — Incident Reports: SIEM Investigations.';
---

<html lang="en">
  <head>
    <BaseHead title={pageTitle} description={pageDescription} />
    <style>
      /* Override global `main` fixed width and ensure responsive sizing */
      main.projects {
        width: 100%;
        max-width: 980px;
        box-sizing: border-box;
        margin: 0 auto;
        padding: var(--page-padding-vertical) var(--page-padding-horizontal);
      }
      .section h2 { margin-bottom: 1rem; }

      /* Responsive grid: 1 column on small, 2 on medium, auto-fit on larger */
      .projects-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 1rem;
        align-items: start;
      }

      .card {
        background: var(--surface-bg);
        border-radius: 10px;
        text-align: center;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        min-width: 0; /* allow flex/grid children to shrink on small viewports */
      }

      /* Use aspect-ratio so images scale responsively instead of fixed heights */
      .card img {
        width: 100%;
        height: auto;
        aspect-ratio: 16/9;
        object-fit: cover;
        border-radius: 6px;
        display: block;
        margin: 0;
      }

      .card a { text-decoration: none; color: inherit; display:block; }
      .card-title { margin-top: 0.25rem; font-weight:600; }

      /* Small screens: keep the same outer padding so margins remain consistent */
      @media (max-width: 720px) {
        main.projects { padding: var(--page-padding-vertical) var(--page-padding-horizontal) !important; }
        .projects-grid { grid-template-columns: 1fr !important; display: grid !important; width: 100% !important; }
        .card { padding: 0.75rem 0.5rem; }
      }

      /* Ensure strict stacking on very small viewports (older browsers, quirks, or when grid columns still fit) */
      @media (max-width: 480px) {
        .projects-grid { display: block !important; }
        .card { width: 100% !important; margin-bottom: 1rem; }
        .card:last-child { margin-bottom: 0; }
      }

      /* Very wide screens: allow larger thumbnails */
      @media (min-width: 1200px) {
        .projects-grid { grid-template-columns: repeat(3, 1fr); }
      }
    </style>
  </head>
  <body>
    <Header />
    <main class="projects" role="main">
      <article>
        <header style="margin-bottom: 4rem;">
          <h1>Projects</h1>
        </header>

        <section class="section" aria-labelledby="incident-reports">
          <h2 id="incident-reports">SIEM Investigations</h2>
          
          <div class="projects-grid">
            <div class="card">
              <a href="/projects/incident-reports/cyberlabs-final" aria-label="Open Incident Report CyberLabs Final">
                <img class="theme-img" src="/assets/images/ransomware_light.png" data-img-light="/assets/images/ransomware_light.png" data-img-dark="/assets/images/ransomware_dark.png" data-img-default="/assets/images/ransomware_light.png" alt="Ransomware Attack" />
              </a>
            </div>

            <div class="card">
              <a href="/projects/incident-reports/cyberlabs-test" aria-label="Open Incident Report CyberLabs Test">
                <img class="theme-img" src="/assets/images/bruteforce-to-exfiltration_light.png" data-img-light="/assets/images/bruteforce-to-exfiltration_light.png" data-img-dark="/assets/images/bruteforce-to-exfiltration_dark.png" data-img-default="/assets/images/bruteforce-to-exfiltration_light.png" alt="Internal Host Compromise" />
              </a>
            </div>
          </div>
        </section>
      </article>
    </main>
    <Footer />
  </body>
</html>
