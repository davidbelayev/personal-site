---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const pageTitle = 'Projects';
const pageDescription = 'Project portfolio — Incident Reports: SIEM Investigations.';
---

<html lang="en">
  <head>
    <BaseHead title={pageTitle} description={pageDescription} />
    <style>
      main.projects { max-width: 980px; margin: 0 auto; padding: 3rem 1.25rem; }
      .section h2 { margin-bottom: 1rem; }
      .projects-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px,1fr)); gap: 1rem; }
      .card { background: var(--surface-bg); padding: 1rem; border-radius: 10px; text-align: center; }
      .card img { width: 100%; height: 220px; object-fit: cover; border-radius: 6px; }
      .card a { text-decoration: none; color: inherit; display:block; }
      .card-title { margin-top: 0.75rem; font-weight:600; }
    </style>
  </head>
  <body>
    <Header />
    <main class="projects" role="main">
      <article>
        <header style="margin-bottom: 4rem;">
          <h1>Projects</h1>
        </header>

        <section class="section" aria-labelledby="incident-reports">
          <h2 id="incident-reports">Incident Reports — SIEM Investigations</h2>
          
          <div class="projects-grid">
            <div class="card">
              <a href="/projects/incident-reports/cyberlabs-final" aria-label="Open Incident Report CyberLabs Final">
                <img src="/assets/images/cyberlabs-final.png" alt="Ransomware Attack" />
                <div class="card-title">Ransomware Attack</div>
              </a>
            </div>

            <div class="card">
              <a href="/projects/incident-reports/cyberlabs-test" aria-label="Open Incident Report CyberLabs Test">
                <img src="/assets/images/cyberlabs-test.png" alt="Internal Host Compromise" />
                <div class="card-title">Internal Host Compromise</div>
              </a>
            </div>
          </div>
        </section>
      </article>
    </main>
    <Footer />
  </body>
</html>
